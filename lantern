#!/usr/bin/env bash
# Launch Lantern and open it in your browser.
set -euo pipefail
cd "$(dirname "$0")"

# Share one history with Lantern.app instead of creating a second one in ./data.
# This is a bash script, so Linux reaches it too — and Application Support is
# meaningless there, so it would have quietly created ~/Library on a Linux box.
if [ -z "${LANTERN_DATA:-}" ]; then
  case "$(uname -s)" in
    Darwin) LANTERN_DATA="$HOME/Library/Application Support/Lantern" ;;
    *)      LANTERN_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/lantern" ;;
  esac
fi
export LANTERN_DATA

BACKEND="$(python3 -c 'import json,os; p=os.path.join(os.environ["LANTERN_DATA"],"settings.json"); print(json.load(open(p)).get("backend","ollama") if os.path.isfile(p) else "ollama")' 2>/dev/null || echo ollama)"
if [ "$BACKEND" = "openai" ]; then
  exec python3 server.py --open "$@"
fi

if ! command -v ollama >/dev/null 2>&1; then
  echo "Ollama isn't installed. Get it from https://ollama.com/download" >&2
  exit 1
fi

# Start ollama in the background if it isn't already listening.
if ! curl -sf --max-time 2 "${OLLAMA_HOST:-http://127.0.0.1:11434}/api/tags" >/dev/null 2>&1; then
  echo "Starting ollama serve…"
  ollama serve >/dev/null 2>&1 &
  for _ in $(seq 1 20); do
    sleep 0.4
    curl -sf --max-time 2 "${OLLAMA_HOST:-http://127.0.0.1:11434}/api/tags" >/dev/null 2>&1 && break
  done
fi

exec python3 server.py --open "$@"
